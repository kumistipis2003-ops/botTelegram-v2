{
    "version": 2,
    "builds": [
        {
            "src": "api/webhook.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/webhook",
            "dest": "/api/webhook.py"
        },
        {
            "src": "/api/set_webhook",
            "dest": "/api/webhook.py"
        },
        {
            "src": "/(.*)",
            "dest": "/api/webhook.py"
        }
    ],
    "functions": {
        "api/webhook.py": {
            "memory": 1024,
            "maxDuration": 60
        }
    }
}
